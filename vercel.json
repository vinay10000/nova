{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix backend",
  "buildCommand": "npm run build --prefix backend",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": ["backend/dist/**", "backend/node_modules/.prisma/**"]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
