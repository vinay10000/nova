{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix backend",
  "buildCommand": "npm run build --prefix backend",
  "functions": {
    "backend/api/index.js": {
      "maxDuration": 60,
      "includeFiles": "backend/node_modules/.prisma/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/backend/api/index.js" }]
}
