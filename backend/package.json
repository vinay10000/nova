{
  "name": "nova-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsx src/tools/Tool.test.ts && tsx src/auth.test.ts && tsx src/services/fileService.test.ts && tsx src/services/chatPlugins.test.ts && tsx src/agent/runtime.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.1.1",
    "@google/genai": "^2.22.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "fastify": "^5.12.4",
    "jose": "^6.2.12",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
