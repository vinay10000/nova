# Server-side only. NEVER ship to APK (§46).
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova
GEMINI_API_KEY=
AUTH_JWT_SECRET=change-me
PORT=3000
# AI_API_KEY is accepted as a backwards-compatible alias for GEMINI_API_KEY.
# TTS via Gemini 2.5 Flash Native Audio Dialog — uses the same key.
EXA_API_KEY= # server only — web.search tool via Exa Search API (§40)

# Function-calling AI router (§2/§15). Chat tools (@github, @gmail, @calendar,
# @leetcode) are sent to a function-calling-capable model. Server only — never in
# the APK (§46). Without this key, tools are still sent on the chat router but
# function calling may not work.
AI_API_KEY=
TOOLS_BASE_URL= # override only — defaults to Google AI Studio OpenAI-compatible endpoint
TOOLS_API_KEY= # optional; falls back to GEMINI_API_KEY
TOOLS_MODEL=gemini-3.5-flash-lite
# Optional cheap-model override; must be one of the models exposed by /v1/models.
MODEL_CHEAP=gemini-3.1-flash-lite

# §18 LeetCode — public open-source wrapper (github.com/alfaarghya/alfa-leetcode-api).
# No key needed; override only if you self-host the wrapper.
LEETCODE_API_BASE=https://alfa-leetcode-api.onrender.com

# §38 GitHub OAuth — create a GitHub OAuth App at https://github.com/settings/developers
# Authorization callback URL must be: {BACKEND_PUBLIC_URL}/v1/connections/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# §38 Gmail OAuth — Google Cloud Console → APIs & Services → Enable Gmail API,
# then Credentials → OAuth client ID (Web) with redirect:
# {BACKEND_PUBLIC_URL}/v1/connections/gmail/callback
# Same client also serves Calendar + Drive — add ALL redirects on it:
#   {BACKEND_PUBLIC_URL}/v1/connections/calendar/callback
#   {BACKEND_PUBLIC_URL}/v1/connections/drive/callback
# Consent scopes: gmail.readonly + gmail.send. Server only, never APK (§46).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# §46 AES-256-GCM master key for encrypting OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=

# Backend public URL — used as the OAuth callback redirect target and for deep links.
BACKEND_PUBLIC_URL=http://localhost:3000

# Android deep link scheme — the app registers this scheme (manifest intent-filter
# on host "connections") to receive OAuth callbacks. Must match DEEP_LINK_SCHEME
# in the APK build; success = {scheme}://connections/{provider}/connected,
# failure = {scheme}://connections/{provider}/error?error=<code>.
DEEP_LINK_SCHEME=nova

# F2 Drive/Docs/Sheets — same Google Cloud client as Gmail; enable Drive, Docs,
# Sheets APIs and add redirect: {BACKEND_PUBLIC_URL}/v1/connections/drive/callback
# Consent scopes: drive.readonly + documents + spreadsheets.

# F2 Vercel — per-user token pasted in Connections (no env key needed).
# F2 Supabase — per-user project ref + key pasted in Connections (no env key needed).

# F3 Agent Mode — free tiers. Browserless (1000 req/mo free) for cloud browser,
# E2B (free tier) for cloud code workspaces. Server only, never APK.
BROWSERLESS_API_KEY=
E2B_API_KEY=
# Optional origin allowlist for the cloud browser (comma-separated https origins).
# Empty = open mode (any https, SSRF guards still on).
BROWSER_ALLOWED_ORIGINS=
