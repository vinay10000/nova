{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": "node_modules/.prisma/**, node_modules/@prisma/**"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.js" }]
}